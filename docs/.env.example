# 爆文猎人 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== 必填 ====================

# 数据库连接（PostgreSQL）
DATABASE_URL=postgresql://viral_hunter:your_password@localhost:5432/viral_hunter

# JWT 密钥（生产环境必须更换！建议用 openssl rand -hex 32 生成）
JWT_SECRET=your-jwt-secret-change-this-in-production

# LLM API 密钥（支持 OpenAI 兼容接口）
OPENAI_API_KEY=sk-your-openai-api-key
# LLM 基础 URL（如使用国内代理，替换为代理地址）
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM 模型选择
OPENAI_MODEL=gpt-4o-mini

# ==================== 可选 - 外部采集 ====================

# 红狐数据 API Key（小红书/公众号采集）
REDFOX_API_KEY=
# B站采集（公开API，无需Key但有限流）
BILIBILI_SESSDATA=

# ==================== 可选 - 服务配置 ====================

# 应用配置
APP_ENV=development          # development / production
APP_PORT=8000                # 后端端口
APP_DEBUG=true               # 调试模式

# Redis（可选，不配置则使用内存缓存）
REDIS_URL=redis://localhost:6379/0

# CORS 允许的前端域名
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ==================== 可选 - 业务配置 ====================

# 上传配置
UPLOAD_MAX_FILE_SIZE=5242880          # 单文件最大5MB
UPLOAD_MAX_FILES_PER_BATCH=20         # 单次最多20个文件
UPLOAD_THRESHOLD=10                   # 触发分析的最低文件数

# LLM 成本控制
LLM_DAILY_TOKEN_LIMIT=1000000         # 每日Token消耗上限
LLM_ANALYSIS_MAX_RETRIES=2            # 分析最大重试次数
LLM_REWRITE_MAX_RETRIES=1             # 改写最大重试次数
LLM_REWRITE_SIMILARITY_THRESHOLD=0.6  # 改写相似度阈值（0-1）

# 管理员配置
FIRST_USER_IS_ADMIN=true              # 首个注册用户自动成为管理员

# ==================== 可选 - 日志与监控 ====================

LOG_LEVEL=INFO                        # DEBUG/INFO/WARNING/ERROR
LOG_FILE=logs/app.log                 # 日志文件路径
