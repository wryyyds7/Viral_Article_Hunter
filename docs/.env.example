# 爆文猎人 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== 必填 ====================

# 数据库连接（PostgreSQL + asyncpg）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/viral_hunter

# JWT 密钥（生产环境必须更换！建议用 openssl rand -hex 32 生成）
JWT_SECRET=your-jwt-secret-change-this-in-production

# AES-256 加密密钥（32 字节字符串，用于 API Key 加密存储）
ENCRYPTION_KEY=change-this-to-a-32-byte-secret-key

# LLM API 配置（OpenAI 兼容接口）
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_LITE_MODEL=deepseek-chat

# ==================== 可选 - 外部采集 ====================

# 红狐数据 API（小红书/知乎采集）
REDFOX_API_KEY=
REDFOX_BASE_URL=https://api.redfoxdata.com

# 通用搜索 API（预留）
SEARCH_API_KEY=
SEARCH_BASE_URL=

# B站采集（可选，SESSDATA 提高限额）
BILIBILI_SESSDATA=

# 微博采集（可选，Cookie 提高稳定性）
WEIBO_COOKIE=

# MediaCrawler 集成（可选高级模式）
# 安装: git clone https://github.com/NanmiCoder/MediaCrawler.git
# 设置路径并启用后，采集将使用浏览器自动化（支持登录态）
MEDIACRAWLER_PATH=
MEDIACRAWLER_ENABLED=false

# ==================== 可选 - 基础设施 ====================

# Redis（可选，不配置则使用内存缓存）
REDIS_URL=redis://localhost:6379/0

# CORS 允许的前端域名
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000

# ==================== 可选 - 业务配置 ====================

# 上传配置
UPLOAD_THRESHOLD=10                   # 触发分析的最低文件数
MAX_FILE_SIZE_MB=5                    # 单文件最大 5MB
UPLOAD_DIR=/tmp/vh_uploads            # 上传临时目录

# LLM 成本控制
LLM_MAX_RETRIES=1                     # LLM 最大重试次数
LLM_TIMEOUT=90                        # LLM 请求超时（秒）
LLM_MAX_TOKENS=4096                   # 单次请求最大 Token 数

# 改写配置
REWRITE_SIMILARITY_THRESHOLD=0.6      # 改写相似度阈值（0-1）

# 配额默认值
DEFAULT_DAILY_LLM_TOKENS=100000
DEFAULT_DAILY_REWRITES=50
DEFAULT_DAILY_COLLECTIONS=30
DEFAULT_DAILY_UPLOADS=100

# 限流（次/分钟）
RATE_LIMIT_COLLECT=5
RATE_LIMIT_UPLOAD=5
RATE_LIMIT_ANALYSIS=10
RATE_LIMIT_REWRITE=3
RATE_LIMIT_ADMIN=30

# ==================== 可选 - 日志与监控 ====================

LOG_LEVEL=INFO                        # DEBUG/INFO/WARNING/ERROR
