[project]
requires = ["python-3.11"]
template = "custom"
version = "0.0.28"
appliedPatches = []

[dev]
build = ["bash", "-c", "cd backend && pip install -r requirements.txt -q"]
run = ["bash", "-c", "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 5000 --reload"]
deps = ["git"]

[deploy]
build = ["bash", "-c", "cd backend && pip install -r requirements.txt -q"]
run = ["bash", "-c", "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 5000 --workers 2"]
deps = ["git"]
