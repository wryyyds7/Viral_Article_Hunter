[project]
requires = ["nodejs-24"]
template = "native-static"
version = "0.0.30"
appliedPatches = []

[dev]
build = ["bash", "-c", "cd backend && pip install -r requirements.txt -q 2>/dev/null"]
run = ["bash", "-c", "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 5000 --reload"]
deps = ["git"]

[deploy]
build = ["bash", "-c", "cd backend && pip install -r requirements.txt -q 2>/dev/null"]
run = ["bash", "-c", "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 5000 --workers 2"]
deps = ["git"]
